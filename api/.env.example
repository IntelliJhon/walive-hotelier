# --- Server ---
PORT=4000
DATABASE_URL=postgresql://walive:walive@localhost:5433/walive
# Where the booking web app is served (used to build the link sent on WhatsApp)
WEB_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# --- Hotelier PMS (values supplied by the Hotelier team) ---
PMS_BASE_URL=http://<pms-host>:<port>
PMS_KEY=
PMS_SOURCE=WALIVE
PMS_GROUP_ID=
# Empty = the PMS default rate type
PMS_RATE_TYPE=
PMS_TIMEOUT_MS=20000
CHECKIN_TIME=12:00
CHECKOUT_TIME=11:00

# --- Booking rules ---
SESSION_MINUTES=30
HOLD_MINUTES=15
# test = "Pay (test)" button sends a synthetic transaction. Set to sbiepay once the gateway is configured.
PAYMENT_MODE=test

# --- n8n ---
# Shared secret: n8n sends it to the API, and the API sends it to n8n
CHAT_API_SECRET=change-me-long-random-string
# n8n webhook that sends WhatsApp messages (booking confirmed / failed / expired). Leave empty to skip.
N8N_NOTIFY_URL=

# The bot's WhatsApp number with country code (e.g. 919876543210). After a booking is
# confirmed the web app sends the guest back to this chat. Leave empty to disable.
BOT_WHATSAPP_NUMBER=

# --- Admin dashboard ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
